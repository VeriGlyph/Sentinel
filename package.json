{
  "name": "veriglyph-sentinel",
  "version": "2.0.0",
  "description": "Veriglyph Sentinel Certificate Indexer",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "jest --runInBand",
    "migrate": "node -r ts-node/register ./node_modules/knex/bin/cli.js migrate:latest"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "blakejs": "^1.2.1",
    "cbor": "^9.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "knex": "^2.5.1",
    "pg": "^8.11.5",
    "pino": "^8.17.0",
    "pino-pretty": "^10.2.0",
    "tweetnacl": "^1.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cbor": "^5.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.30",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "ts-node": "^10.9.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
